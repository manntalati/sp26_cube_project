GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5000/api/auth/google/callback

# Security configuration
FLASK_SECRET_KEY=meetingmind_dev_secret_key_12345
FRONTEND_URL=http://localhost:5173
PORT=5000
